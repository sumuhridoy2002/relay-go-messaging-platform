PORT=8080

DATABASE_URL=postgres://postgres:password@127.0.0.1:5432/relay?sslmode=disable

REDIS_URL=redis://127.0.0.1:6379/0

JWT_ACCESS_SECRET=replace-with-a-long-random-secret | generate using command `-join ((1..48 | ForEach-Object { '{0:x2}' -f (Get-Random -Maximum 256) }))`

